# 复制为 .env 并填写。PaperQA 通过 LiteLLM 调用模型，需配置对应 API Key。
OPENAI_API_KEY=sk-...

# 可选：覆盖默认模型（与 paper-qa Settings 一致）
# PAPERQA_LLM=gpt-4o-mini
# PAPERQA_SUMMARY_LLM=gpt-4o-mini
# PAPERQA_EMBEDDING=text-embedding-3-small

# 微信公众平台（服务号）
WECHAT_TOKEN=your_random_token_string
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 服务监听
HOST=0.0.0.0
PORT=8000

# SQLite 与会话数据目录
DATABASE_URL=sqlite+aiosqlite:///./data/paperstudio.db
DATA_DIR=./data
